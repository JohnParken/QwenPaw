# Required upstream settings
UPSTREAM_PROVIDER=deepseek
UPSTREAM_MODEL=deepseek-chat
UPSTREAM_BASE_URL=https://api.deepseek.com
UPSTREAM_API_KEY=replace-with-a-test-key
# Qwen instance alternative:
# UPSTREAM_PROVIDER=qwen
# UPSTREAM_MODEL=qwen3.8-flash
# UPSTREAM_BASE_URL=https://<workspace-and-region>/compatible-mode/v1

# Listener and protocol behavior
TL_PROXY_HOST=127.0.0.1
TL_PROXY_PORT=8089
UPSTREAM_THINKING=provider-default
SYSTEM_PROMPT_VARIABLE_NAME=system_prompt
LEGACY_ROLE_TEXT=true
LOG_LEVEL=debug
AUTH_MODE=local
TEST_ACCESS_TOKEN=replace-for-bearer-mode
CORS_ALLOWED_ORIGINS=

# Timeouts, byte limits, and bounded resources
UPSTREAM_TIMEOUT_MS=120000
STREAM_IDLE_TIMEOUT_MS=30000
REQUEST_BODY_TIMEOUT_MS=30000
SHUTDOWN_TIMEOUT_MS=5000
MAX_REQUEST_BYTES=1048576
MAX_RESPONSE_BYTES=4194304
MAX_UPSTREAM_WIRE_BYTES=67108864
MAX_DOWNSTREAM_WIRE_BYTES=67108864
MAX_SSE_EVENT_BYTES=262144
MAX_DOWNSTREAM_EVENT_BYTES=1048576
SESSION_TTL_MS=900000
MAX_SESSIONS=10000
MAX_INFLIGHT_REQUESTS=32
MAX_LOG_QUEUE_BYTES=134217728
