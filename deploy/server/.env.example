# Production /v1. Copy outside version control and fill required values.
# serve does NOT auto-load this file. From the repository root:
# set -a; . /absolute/path/to/server.env; set +a
# .venv/bin/qwenpaw serve check --json
# .venv/bin/qwenpaw serve migrate
# Launch api, worker and controller as separate processes after migration.
# Percent-encode credentials in mysql://user:password@host:3306/database.
QWENPAW_SERVER_DATABASE_URL=''
QWENPAW_SERVER_SERVICE_TOKEN=''
QWENPAW_SERVER_INTERNAL_TOKEN=''
# Both tokens must contain at least 32 characters; generate independent secrets.
QWENPAW_SERVER_DEFINITION_PATH='deploy/server/assistant.tl.json'
# In Kubernetes use /config/assistant.json; set TL base_url in that JSON
# to the reachable TL service root, not a Pod's localhost.
QWENPAW_SERVER_MODEL_API_KEY=''
QWENPAW_SERVER_CONTROLLER_URL='http://qwenpaw-controller:8091'
QWENPAW_SERVER_STORAGE_TABLE_PREFIX='qp_service_'
QWENPAW_SERVER_DATABASE_POOL_SIZE=10
QWENPAW_SERVER_CONCURRENCY=10
QWENPAW_SERVER_PER_USER_CONCURRENCY=4
QWENPAW_SERVER_LEASE_SECONDS=60
QWENPAW_SERVER_APPROVAL_TIMEOUT=600
QWENPAW_SERVER_IDLE_SECONDS=900
# Redis is optional. Leave unset to use durable database polling.
# QWENPAW_SERVER_REDIS_URL='redis://redis:6379/0'
QWENPAW_SERVER_NAMESPACE='qwenpaw'
QWENPAW_SERVER_SANDBOX_IMAGE='qwenpaw-server:local'
QWENPAW_SERVER_WORKSPACE_PVC='qwenpaw-workspaces'
QWENPAW_SERVER_WORKSPACE_ROOT='/workspaces'
QWENPAW_SERVER_S3_BUCKET='qwenpaw-files'
QWENPAW_SERVER_S3_REGION='us-east-1'
# Set for an S3-compatible endpoint; otherwise use the AWS default endpoint.
# QWENPAW_SERVER_S3_ENDPOINT='https://objects.example.internal'
# Supply object-store credentials through the standard AWS credential chain.
QWENPAW_SERVER_MAX_UPLOAD_BYTES=20971520
# Model payload logging is opt-in; see docs/model-debug.md.
QWENPAW_MODEL_DEBUG=0
