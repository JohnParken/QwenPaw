FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    QWENPAW_OFFICE_PRODUCTION=true \
    QWENPAW_OFFICE_HOST=0.0.0.0 \
    QWENPAW_OFFICE_PORT=8090 \
    QWENPAW_OFFICE_OBJECT_STORE_BACKEND=s3 \
    QWENPAW_OFFICE_SKILL_BUNDLE_PATH=/opt/qwenpaw-office/skills \
    QWENPAW_OFFICE_WORK_ROOT=/tmp/qwenpaw-office

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        libreoffice-calc \
        libreoffice-impress \
        libreoffice-writer \
        poppler-utils \
        fonts-noto-cjk \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /opt/qwenpaw-source
COPY . .

RUN python -m pip install --no-cache-dir '.[cloud,office]' \
    && mkdir -p /opt/qwenpaw-office \
    && cp -a src/qwenpaw/office/skills /opt/qwenpaw-office/skills \
    && find /opt/qwenpaw-office/skills -type d -exec chmod 0555 {} + \
    && find /opt/qwenpaw-office/skills -type f -exec chmod 0444 {} + \
    && mkdir -p /tmp/qwenpaw-office \
    && chown -R 65532:65532 /tmp/qwenpaw-office

USER 65532:65532
EXPOSE 8090

ENTRYPOINT ["qwenpaw-office"]
