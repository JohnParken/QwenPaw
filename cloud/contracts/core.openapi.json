  "components": {
    "schemas": {
      "AttemptAction": {
        "properties": {
          "attempt_id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,79}$",
            "title": "Attempt Id"
          },
          "lease_epoch": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Lease Epoch"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "attempt_id",
          "lease_epoch"
        ],
        "title": "AttemptAction"
      },
      "Boundary": {
        "properties": {
          "attempt_id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,79}$",
            "title": "Attempt Id"
          },
          "lease_epoch": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Lease Epoch"
          },
          "action": {
            "type": "string",
            "enum": [
              "handoff",
              "finish",
              "failed"
            ],
            "title": "Action"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "attempt_id",
          "lease_epoch",
          "action"
        ],
        "title": "Boundary"
      },
      "Checkpoint": {
        "properties": {
          "attempt_id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,79}$",
            "title": "Attempt Id"
          },
          "lease_epoch": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Lease Epoch"
          },
          "commit_id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,79}$",
            "title": "Commit Id"
          },
          "expected_revision": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Expected Revision"
          },
          "conversation_ref": {
            "$ref": "#/components/schemas/FileRef"
          },
          "files": {
            "additionalProperties": {
              "$ref": "#/components/schemas/FileRef"
            },
            "type": "object",
            "maxProperties": 16,
            "title": "Files"
          },
          "cursor": {
            "type": "integer",
            "maximum": 2.0,
            "minimum": 1.0,
            "title": "Cursor"
          },
          "next_segment": {
            "type": "integer",
            "maximum": 3.0,
            "minimum": 2.0,
            "title": "Next Segment"
          },
          "budget": {
            "additionalProperties": {
              "type": "integer"
            },
            "type": "object",
            "title": "Budget"
          },
          "memory": {
            "type": "null",
            "title": "Memory"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "attempt_id",
          "lease_epoch",
          "commit_id",
          "expected_revision",
          "conversation_ref",
          "cursor",
          "next_segment",
          "budget"
        ],
        "title": "Checkpoint"
      },
      "Claim": {
        "properties": {
          "request_id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,79}$",
            "title": "Request Id"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "request_id"
        ],
        "title": "Claim"
      },
      "Cleanup": {
        "properties": {
          "attempt_id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,79}$",
            "title": "Attempt Id"
          },
          "lease_epoch": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Lease Epoch"
          },
          "confirmed": {
            "type": "boolean",
            "title": "Confirmed"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "attempt_id",
          "lease_epoch",
          "confirmed"
        ],
        "title": "Cleanup"
      },
      "CreateRun": {
        "properties": {
          "request_id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,79}$",
            "title": "Request Id"
          },
          "scope": {
            "$ref": "#/components/schemas/Scope"
          },
          "session_id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,79}$",
            "title": "Session Id"
          },
          "input_ref": {
            "$ref": "#/components/schemas/FileRef"
          },
          "runtime_identity": {
            "$ref": "#/components/schemas/RuntimeIdentity"
          },
          "expected_revision": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Expected Revision"
          },
          "base_policy": {
            "type": "string",
            "const": "latest_at_claim",
            "title": "Base Policy",
            "default": "latest_at_claim"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "request_id",
          "scope",
          "session_id",
          "input_ref",
          "runtime_identity"
        ],
        "title": "CreateRun"
      },
      "FileRef": {
        "properties": {
          "file_id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,79}$",
            "title": "File Id"
          },
          "version": {
            "type": "integer",
            "const": 1,
            "title": "Version",
            "default": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$",
            "title": "Sha256"
          },
          "size": {
            "type": "integer",
            "maximum": 1048576.0,
            "minimum": 0.0,
            "title": "Size"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "file_id",
          "sha256",
          "size"
        ],
        "title": "FileRef"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Register": {
        "properties": {
          "worker_id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,79}$",
            "title": "Worker Id"
          },
          "runtime_identity": {
            "$ref": "#/components/schemas/RuntimeIdentity"
          },
          "executor": {
            "type": "string",
            "enum": [
              "fixture",
              "native"
            ],
            "title": "Executor"
          },
          "slots": {
            "type": "integer",
            "const": 1,
            "title": "Slots",
            "default": 1
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
