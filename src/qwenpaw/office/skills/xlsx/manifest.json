{
  "id": "xlsx",
  "name": "xlsx",
  "version": "1.0.0",
  "description": "Read, transform, create, and validate Excel workbooks and tabular data.",
  "entrypoints": [],
  "python_packages": ["openpyxl", "pandas", "pyarrow", "xlsxwriter"],
  "node_packages": [],
  "allowed_commands": [],
  "allowed_tools": ["list_files", "read_file", "write_file", "copy_file", "create_xlsx", "read_xlsx", "read_table", "profile_table", "aggregate_table", "pivot_table", "create_chart", "publish_artifact", "run_skill_script"],
  "supported_mime_types": ["application/vnd.openxmlformats-officedocument.spreadsheetml.sheet", "text/csv", "text/tab-separated-values", "application/vnd.apache.parquet"],
  "output_patterns": ["*.xlsx", "*.csv", "*.tsv", "*.parquet"],
  "runtime": "python",
  "network": "disabled",
  "timeout_seconds": 120,
  "max_output_bytes": 65536,
  "metadata": {"builtin": true, "required_commands": ["libreoffice", "pdftoppm"]}
}
